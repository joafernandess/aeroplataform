# =============================================================
# Copy this file to ".env" and fill in the values.
# =============================================================

# --- REQUIRED ----------------------------------------------------------------
# Bot token (Discord Developer Portal > Bot > Reset Token > Copy)
DISCORD_TOKEN=PASTE_YOUR_TOKEN_HERE

# ID of the "@Buyer" role (right-click the role > Copy Role ID)
BUYER_ROLE_ID=000000000000000000

# ID of the administration role - OWNER level (/ban /unban /extend
# /postpanel /postshop)
ADMIN_ROLE_ID=000000000000000000

# ID of the staff role - STAFF level (/genkey /keyinfo /userinfo /listkeys
# /setnote /deliver). Empty = these commands are restricted to the owner.
STAFF_ROLE_ID=

# --- RECOMMENDED -------------------------------------------------------------
# ID of your test server (slash commands appear immediately).
# Empty = global sync (can take up to 1 hour).
GUILD_ID=000000000000000000

# --- OPTIONAL ----------------------------------------------------------------
# Default channel for /postpanel (can be left blank and given in the command)
PANEL_CHANNEL_ID=

# Channel that receives event logs (redemptions, executions, HWID mismatches,
# bans...). Empty = logging disabled.
LOG_CHANNEL_ID=

# Separate channel for security events (failed redeems, key-sharing attempts,
# permission denials, errors). Empty = they go to LOG_CHANNEL_ID.
SECURITY_LOG_CHANNEL_ID=

# Panel text
PANEL_TITLE=Script Panel - Click below
PANEL_DESCRIPTION=Click the buttons below to redeem your key, get the script, claim your role, reset your HWID or view your key stats.

# Maximum HWID resets per key (anti key-sharing)
MAX_HWID_RESETS=3

# Give the @Buyer role automatically when a key is redeemed (1 = on, 0 = off)
AUTO_ROLE_ON_REDEEM=1

# Accounts younger than this many days cannot redeem keys (0 = disabled)
MIN_ACCOUNT_AGE_DAYS=0

# Anti brute-force on Redeem Key (per 10 minutes)
REDEEM_USER_FAIL_LIMIT=4
REDEEM_GLOBAL_FAIL_LIMIT=30

# Category where buy tickets are created (empty = auto-creates "Tickets")
TICKET_CATEGORY_ID=

# --- API ---------------------------------------------------------------------
# Local port of the HTTP server embedded in the bot
API_PORT=8720

# Max requests per IP per minute on /v1/execute (anti brute-force)
API_RATE_LIMIT=30

# Public URL that the script uses to download the payload.
# Local test: http://127.0.0.1:8720
# Production (others need to reach it): https://your-domain.com
PUBLIC_API_URL=http://127.0.0.1:8720

# Interface of the public API. Keep 127.0.0.1 with the Cloudflare tunnel.
API_HOST=127.0.0.1

# --- DASHBOARD + PRIVATE BOT API ---------------------------------------------
# Private server (loopback only - never route it through the tunnel unprotected)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8721

# Extra hostnames the dashboard accepts (comma separated), e.g. one protected
# by Cloudflare Access. Empty = only 127.0.0.1 / localhost.
DASHBOARD_ALLOWED_HOSTS=

# Admin session lifetime (hours)
DASHBOARD_SESSION_HOURS=12

# Token the bot uses on the private API. Empty = generated automatically
# into data/bot_api_token (fine when bot and API run together).
BOT_API_TOKEN=

# Max private API requests per minute per key
BOT_API_RATE_LIMIT=20

# Days of request/activity logs kept
ACCESS_LOG_DAYS=30

# --- EXECUTION LOGS ----------------------------------------------------------
# Forum channel for execution logs: one post per buyer, every execution of
# their key is logged inside it (Roblox account, server, device, IP, HWID).
# Needs the Aero Platform bridge (PLATFORM_API_URL + PLATFORM_API_TOKEN).
EXEC_LOG_FORUM_ID=
# How often the bot pulls new executions from the platform (seconds)
EXEC_LOG_POLL_SECONDS=15
# Also log refused executions (invalid key, HWID mismatch...) (1/0)
EXEC_LOG_DENIED=1
# Alert when a key runs from this many different IPs in 24 h
SHARE_ALERT_IPS=3
# Alert when one IP uses this many different keys in 24 h
IP_MULTI_KEY_ALERT=3

# --- SECURITY ----------------------------------------------------------------
# Ban keys automatically when they run with a blacklisted HWID / Roblox account
BLACKLIST_AUTO_BAN=1
# Alert after this many failed platform checks (1 per minute)
WATCHDOG_FAILS=3
# Optional: also send platform down/up alerts to this Discord webhook
WATCHDOG_WEBHOOK_URL=

# Privileged intents: enable them in the Developer Portal (Bot tab) FIRST,
# otherwise the bot cannot log in.
#   MEMBERS_INTENT=1         -> "Server Members Intent": "buyer left" alerts
#   MESSAGE_CONTENT_INTENT=1 -> "Message Content Intent": full ticket transcripts
MEMBERS_INTENT=0
MESSAGE_CONTENT_INTENT=0

# --- SHOP --------------------------------------------------------------------
# Channel for ticket transcripts (empty = LOG_CHANNEL_ID)
TRANSCRIPT_CHANNEL_ID=
# Currency symbol for /sales
SALES_CURRENCY=$

# --- LOOK --------------------------------------------------------------------
# Upload server emojis named aero_<slot> (aero_success, aero_key, aero_shield,
# aero_shop...) and the bot uses them everywhere. Change the prefix here, or
# point a single slot at any emoji: EMOJI_SUCCESS=<:check:123456789012345678>
EMOJI_PREFIX=aero_
