--[[
	Validate
	Defensive checks for values that arrive from the client. Every RemoteFunction/RemoteEvent handler
	must validate its arguments with these helpers before touching game state. Values from the
	network can be ANY type (including NaN, inf, huge strings, cyclic tables are impossible but deep ones are).
]]

local Validate = {}

function Validate.String(value: any, maxLength: number?): boolean
	return type(value) == "string" and #value > 0 and #value <= (maxLength or 64)
end

function Validate.Number(value: any, min: number?, max: number?): boolean
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return false
	end
	if min and value < min then
		return false
	end
	if max and value > max then
		return false
	end
	return true
end

function Validate.Integer(value: any, min: number?, max: number?): boolean
	return Validate.Number(value, min, max) and value % 1 == 0
end

function Validate.Boolean(value: any): boolean
	return type(value) == "boolean"
end

-- Unit uids are generated by the server as "U<serial>".
function Validate.UnitUid(value: any): boolean
	return type(value) == "string" and #value <= 16 and string.match(value, "^U%d+$") ~= nil
end

-- A list (array) of unique unit uids, at most maxCount long.
function Validate.UnitUidList(value: any, maxCount: number): boolean
	if type(value) ~= "table" then
		return false
	end
	local count = 0
	local seen = {}
	for key, uid in value do
		count += 1
		if type(key) ~= "number" or count > maxCount or not Validate.UnitUid(uid) or seen[uid] then
			return false
		end
		seen[uid] = true
	end
	return count == #value and count > 0
end

-- `set` is either an array of allowed values or a { [value] = anything } map.
function Validate.OneOf(value: any, set: { [any]: any }): boolean
	if value == nil then
		return false
	end
	if set[value] ~= nil then
		return true
	end
	return table.find(set, value) ~= nil
end

return Validate
