--[[
	UpgradeController
	"Upgrades" window: the milestone upgrades (Config/Progression.Milestones) — permanent Yen / Luck / Damage
	bonuses unlocked by playing. Left: a grid of UpgradeCards (Yen I..VI, Luck I..III, Damage I..III, in config
	order). Right: the UpgradeDetailsPanel of the selected card (bonus, requirement, progress, state, CLAIM).
	Bottom: "Upgrades completed X / Y".

	Every text comes from the config: names ("Yen VI") and requirement texts are generated by Progression, the
	progress is read from PlayerData with the shared rules (the same ones the server checks in ClaimMilestone).
	States: Locked (previous tier not claimed) · InProgress · Claimable · Completed.

	Feedback: the Upgrades menu button carries a badge with the number of claimable milestones, a toast says when
	one becomes claimable, and a claimed card pops.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Features = require(Shared.Config.Features)
local Progression = require(Shared.Config.Progression)
local NumberFormat = require(Shared.Modules.NumberFormat)

local Client = script.Parent.Parent
local C = require(Client.UI.Components)
local Cards = require(Client.UI.Cards)
local State = require(Client.State)

local UpgradeController = {
	Name = "UpgradeController",
	Priority = 26,
}

local CARD = UDim2.fromOffset(140, 168)
local GAP = 12
local DETAILS_W = 290
local BAR_H = 40

UpgradeController.Clock = os.clock -- overridable in tests
UpgradeController.Selected = nil :: string?
UpgradeController.States = nil :: { [string]: string }? -- last known state per milestone (toasts on change)

local function color(rgb): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function hoursText(seconds: number, short: boolean): string
	local hours = seconds / 3600
	local value = if math.abs(hours - math.round(hours)) < 0.05 then tostring(math.round(hours)) else ("%.1f"):format(hours)
	if short then
		return value .. "h"
	end
	return value .. (if value == "1" then " hour" else " hours")
end

local function percent(bonus: number): string
	return ("+%d%%"):format(math.round(bonus * 100))
end

-- Live play time on the client: the replicated value plus the time since it last arrived.
function UpgradeController:Playtime(data): number
	return (data.Playtime or 0) + math.max(0, self.Clock() - (self.PlaytimeMark or self.Clock()))
end

--[[
	Everything the window shows for one milestone (pure; tests use it).
	{ Id, Def, Name, Category, Color, Icon, State, Progress, Goal, Fraction, ProgressText, Requirement, Bonus }
]]
function UpgradeController:Info(data, def)
	local category = Progression.GetMilestoneCategory(def.Category)
	local rule = Progression.MilestoneRequirements[def.Requirement.Type]
	local playtime = self:Playtime(data)
	local state = Progression.MilestoneState(data, def, playtime)
	local goal = def.Requirement.Goal
	local progress = if state == "Completed" then goal else math.min(Progression.MilestoneProgress(data, def, playtime), goal)
	local progressText, goalText
	if rule.Hours then
		progressText = ("%s / %s"):format(hoursText(progress, true), hoursText(goal, true))
		goalText = hoursText(goal, false)
	else
		progressText = ("%s / %s"):format(NumberFormat.Abbreviate(math.floor(progress)), NumberFormat.Abbreviate(goal))
		goalText = NumberFormat.Abbreviate(goal)
	end
	return {
		Id = def.Id,
		Def = def,
		Name = Progression.MilestoneName(def),
		Category = category.Name,
		Stat = category.Stat,
		Color = color(category.Color),
		Icon = category.Icon,
		State = state,
		Progress = progress,
		Goal = goal,
		Fraction = progress / goal,
		ProgressText = progressText,
		Requirement = rule.Text:format(goalText),
		Bonus = ("%s %s"):format(percent(def.Bonus), string.upper(category.Stat)),
	}
end

-- (completed, total, claimable)
function UpgradeController:Counts(data): (number, number, number)
	local done, claimable = 0, 0
	local playtime = self:Playtime(data)
	for _, def in Progression.Milestones do
		local state = Progression.MilestoneState(data, def, playtime)
		if state == "Completed" then
			done += 1
		elseif state == "Claimable" then
			claimable += 1
		end
	end
	return done, #Progression.Milestones, claimable
end

-- Default selection: the first claimable milestone, else the first one in progress, else the first.
function UpgradeController:_defaultSelection(data): string?
	local inProgress = nil
	for _, def in Progression.Milestones do
		local state = Progression.MilestoneState(data, def, self:Playtime(data))
		if state == "Claimable" then
			return def.Id
		elseif state == "InProgress" and not inProgress then
			inProgress = def.Id
		end
	end
	return inProgress or (Progression.Milestones[1] and Progression.Milestones[1].Id)
end

function UpgradeController:Claim(id: string)
	local response = State.Request("ClaimMilestone", id)
	if response.ok then
		self.JustClaimed = id
		local def = Progression.GetMilestone(id)
		if def and State.Notify then
			local category = Progression.GetMilestoneCategory(def.Category)
			State.Notify(("%s claimed! %s %s"):format(Progression.MilestoneName(def), percent(def.Bonus), category.Stat), "Success")
		end
	end
	return response
end

function UpgradeController:Select(id: string)
	self.Selected = id
	self:Render()
end

function UpgradeController:_details(data, info)
	local total = Progression.MilestoneBonus(data, info.Stat)
	local note = nil
	if info.State == "Locked" then
		local previous = Progression.PreviousMilestone(info.Def)
		note = if previous then ("Claim %s first."):format(Progression.MilestoneName(previous)) else nil
	end
	self.Details.Show({
		Name = info.Name,
		Category = info.Category,
		Bonus = info.Bonus,
		Color = info.Color,
		Requirement = info.Requirement,
		Fraction = info.Fraction,
		ProgressText = info.ProgressText,
		State = info.State,
		StateNote = note,
		Total = ("Active %s bonus: %s"):format(info.Stat, percent(total)),
		OnClaim = function()
			self:Claim(info.Id)
		end,
	})
end

function UpgradeController:Render()
	local data = State.Data
	if not data or not self.Window.Frame.Visible then
		return
	end
	local enabled = Features.Milestones and #Progression.Milestones > 0
	self.Body.Visible = enabled
	self.Empty.Visible = not enabled
	if not enabled then
		return
	end
	if not (self.Selected and Progression.GetMilestone(self.Selected)) then
		self.Selected = self:_defaultSelection(data)
	end
	C.Clear(self.Grid)
	for order, def in Progression.Milestones do
		local info = self:Info(data, def)
		local card = Cards.UpgradeCard(self.Grid, {
			Id = def.Id,
			Name = info.Name,
			Icon = info.Icon,
			Color = info.Color,
			State = info.State,
			ProgressText = info.ProgressText,
			Selected = def.Id == self.Selected,
		}, function()
			self:Select(def.Id)
		end)
		card.LayoutOrder = order
		if def.Id == self.Selected then
			self:_details(data, info)
		end
		if def.Id == self.JustClaimed then
			Cards.Pop(card)
		end
	end
	self.JustClaimed = nil
	local done, total = self:Counts(data)
	self.Bar.Set(if total > 0 then done / total else 0, "Upgrades completed", ("%d / %d"):format(done, total))
end

-- Badge + "ready to claim" toasts (runs even while the window is closed).
function UpgradeController:_track(data)
	if not Features.Milestones then
		return
	end
	local _, _, claimable = self:Counts(data)
	self.Controllers.UIController:SetMenuBadge("Upgrades", claimable)
	local states = {}
	for _, def in Progression.Milestones do
		states[def.Id] = Progression.MilestoneState(data, def, self:Playtime(data))
	end
	if self.States and State.Notify then
		for _, def in Progression.Milestones do
			if states[def.Id] == "Claimable" and self.States[def.Id] ~= "Claimable" then
				State.Notify(("Upgrade ready: %s! Open Upgrades to claim it."):format(Progression.MilestoneName(def)), "Success")
			end
		end
	end
	self.States = states
end

function UpgradeController:Init(controllers)
	self.Controllers = controllers
	self.Window = controllers.UIController:CreateWindow("Upgrades", "Upgrades", UDim2.fromOffset(960, 560), function()
		self:Render()
	end)
	local content = self.Window.Content
	local body = C.Frame(content, { Name = "Body", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	self.Body = body
	self.Grid = C.Scroll(body, { Name = "Cards", Size = UDim2.new(1, -(DETAILS_W + 14), 1, -(BAR_H + 12)) })
	C.Grid(self.Grid, CARD, GAP)
	C.Create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), Parent = self.Grid })
	self.Details = Cards.UpgradeDetailsPanel(body)
	self.Details.Frame.AnchorPoint = Vector2.new(1, 0)
	self.Details.Frame.Position = UDim2.new(1, -2, 0, 2)
	self.Details.Frame.Size = UDim2.new(0, DETAILS_W, 1, -(BAR_H + 16))
	self.Bar = Cards.LabeledBar(body, { Name = "Completed", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 2, 1, -2), Size = UDim2.new(1, -4, 0, BAR_H) })
	self.Empty = C.EmptyState(content, "upgrades", "Upgrades coming soon", "Permanent bonuses unlocked by playing will appear here.")
	self.Empty.Visible = false
end

function UpgradeController:Start()
	State.Observe({ "Milestones", "Stats", "Quests", "Playtime", "Discovered" }, function(data)
		if data.Playtime ~= self.SeenPlaytime then
			self.SeenPlaytime = data.Playtime
			self.PlaytimeMark = self.Clock()
		end
		self:_track(data)
		self:Render()
	end)
end

return UpgradeController
